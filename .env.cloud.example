# ---------------------------------------------------------------------------
# pierre-review — CLOUD mode environment template
# ---------------------------------------------------------------------------
# These vars are ONLY needed for the multi-tenant cloud deployment (Railway) or
# when running the deployed experience locally with `pierre --cloud`.
#
# Local default mode (SQLite + `gh auth token`) needs NONE of these — just run
# `pnpm dev` or `npx pierre-review`.
#
# Copy to `.env` (repo root) for local cloud-mode testing, or set them as
# service variables on Railway. See docs/LOCAL-CLOUD-TESTING.md and
# docs/DEPLOY-RAILWAY.md.
# ---------------------------------------------------------------------------

# Selects cloud behavior (Postgres, landing page at /, OAuth gate). Default: local.
DEPLOYMENT_MODE=cloud

# Postgres connection string. On Railway this is injected by the Postgres plugin.
# For local cloud testing, point at the docker-compose Postgres:
DATABASE_URL=postgres://pierre:pierre@localhost:5432/pierre_review

# Public base URL of the deployment (no trailing slash). Used to build the OAuth
# redirect_uri and links. Locally this is http://localhost:<port>.
APP_BASE_URL=http://localhost:4000

# Bind address/port. Railway sets PORT; bind HOST=0.0.0.0 in containers.
HOST=0.0.0.0
PORT=4000

# ---- GitHub App (OAuth sign-in) — see docs/GITHUB-APP-SETUP.md ----
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The App's URL slug, used to link users to the install/configure page.
GITHUB_APP_SLUG=

# ---- Secrets (generate with: openssl rand -hex 32) ----
# Seals the session cookie ({accountId}); rotate to invalidate all sessions.
SESSION_SECRET=
# 32-byte key (64 hex chars) for AES-256-GCM encryption of stored access tokens.
ENCRYPTION_KEY=

# Claude Review is force-disabled in cloud mode regardless of this flag.
# ENABLE_CLAUDE_REVIEW=false
