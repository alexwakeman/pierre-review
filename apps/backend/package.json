{
  "name": "@pierre-review/backend",
  "version": "0.1.141",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "verify:isolation": "DATABASE_URL=/tmp/pierre-iso.sqlite DISABLE_SCHEDULER=true tsx scripts/verify-isolation.ts",
    "seed:demo": "DATABASE_URL=/tmp/pierre-demo.sqlite DISABLE_SCHEDULER=true tsx scripts/seed-demo.ts",
    "sync:once": "tsx scripts/sync-once.ts",
    "ml:enrich": "DISABLE_SCHEDULER=true tsx scripts/ml-enrich.ts",
    "ml:backfill-bodies": "DISABLE_SCHEDULER=true tsx scripts/backfill-null-bodies.ts",
    "ml:reparse-badges": "DISABLE_SCHEDULER=true tsx scripts/reparse-vendor-badges.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.295",
    "@anthropic-ai/sdk": "^0.132.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.2",
    "@huggingface/tokenizers": "0.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/graphql": "^8.1.2",
    "@pierre-review/shared": "workspace:*",
    "better-sqlite3": "^11.8.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "mammoth": "^1.13.0",
    "node-cron": "^4.6.0",
    "onnxruntime-node": "1.23.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4"
  },
  "limnAiRuntime": {
    "@openai/codex": "0.164.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
