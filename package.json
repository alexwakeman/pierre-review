{
  "name": "pierre-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "pnpm --filter @pierre-review/backend dev",
    "dev:frontend": "pnpm --filter @pierre-review/frontend dev",
    "build": "pnpm -r build",
    "package": "node scripts/build-release.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify:ui": "node scripts/ui-smoke.mjs",
    "db:generate": "pnpm --filter @pierre-review/backend db:generate",
    "db:migrate": "pnpm --filter @pierre-review/backend db:migrate",
    "db:studio": "pnpm --filter @pierre-review/backend db:studio",
    "sync:once": "pnpm --filter @pierre-review/backend sync:once"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.60.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
