{
  "name": "pierre-review",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "pnpm --filter @pierre-review/backend dev",
    "dev:frontend": "pnpm --filter @pierre-review/frontend dev",
    "build": "pnpm -r build",
    "package": "node scripts/build-release.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify:ui": "node scripts/ui-smoke.mjs",
    "demo": "node scripts/demo-stack.mjs",
    "shots": "node scripts/demo-stack.mjs --shots",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @pierre-review/backend db:generate",
    "db:migrate": "pnpm --filter @pierre-review/backend db:migrate",
    "db:studio": "pnpm --filter @pierre-review/backend db:studio",
    "sync:once": "pnpm --filter @pierre-review/backend sync:once",
    "ml:enrich": "pnpm --filter @pierre-review/backend ml:enrich"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "concurrently": "^9.1.2",
    "playwright": "^1.61.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "brace-expansion@>=3.0.0 <5.0.7": "^5.0.8",
      "shell-quote": "^1.9.0",
      "fast-uri": "^3.1.4",
      "find-my-way": "^9.7.0",
      "hono": "^4.12.32",
      "@hono/node-server": "^2.0.12"
    }
  }
}
