# Backend HTTP port (frontend dev proxy targets this)
PORT=4000

# SQLite database file (relative to apps/backend)
DATABASE_URL=./data/gh-team-monitor.sqlite

# How far back an initial backfill walks, in days
BACKFILL_DAYS=90

# Incremental sync cadence (node-cron expression). Default: every 5 minutes.
SYNC_CRON=*/5 * * * *

# Overlap buffer applied to incremental sync window, in minutes
SYNC_OVERLAP_MINUTES=60

# A PR is "stalled" when open with no commit in this many days and >=1 open thread
STALL_THRESHOLD_DAYS=3
